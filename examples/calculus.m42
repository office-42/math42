(* Calculus: what a first course asks for, in Mathematica's spelling. *)
D[x^3 + Sin[x], x]
D[x^2 y^3, x, y]
Integrate[x Exp[x], x]
Integrate[Sqrt[1 - x^2], x]
Integrate[Sin[x]^3, x]
Integrate[1/(x^2 + 4x + 5), x]
Integrate[Exp[-x] Sin[x], {x, 0, Infinity}]
Limit[(1 - Cos[x])/x^2, x -> 0]
Limit[(1 + 1/n)^n, n -> Infinity]
Series[Sin[x], {x, 0, 7}]
Sum[1/n^2, {n, 1, Infinity}]
Solve[x^3 - 2x^2 - 5x + 6 == 0, x]
DSolve[y'' + 4 y == 0, y, x]
DSolve[y'' + 4 y == Sin[x], y, x]
TrigReduce[Sin[x] Cos[x]]
LaplaceTransform[t Exp[3t], t, s]
FourierSeries[x, {x, -Pi, Pi}, 4]
Plot[{Sin[x], Sin[x]^3}, {x, 0, 2 Pi}]
