<?xml version="1.0" encoding="utf-8"?>
<!-- math42 - the Microsoft Store package manifest.
     Copyright (C) 2026 The math42 authors
     SPDX-License-Identifier: GPL-3.0-or-later

     The identity below is the one the Store assigned to this product;
     it is not ours to choose.  The version is filled in by
     make-msix.sh from the one in meson.build. -->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap3 rescap">

  <Identity
      Name="29567TheFreecivProject.Math42"
      Publisher="CN=631F98F7-2280-49EE-8EF8-534CC36D09CF"
      Version="@VERSION@"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Math42</DisplayName>
    <PublisherDisplayName>Nordstjernen</PublisherDisplayName>
    <Description>A computer algebra and numerics notebook in the shape of Mathematica and MATLAB.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Math42"
                 Executable="bin\math42.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Math42"
          Description="A computer algebra and numerics notebook in the shape of Mathematica and MATLAB."
          BackgroundColor="#1D3557"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
            ShortName="Math42"
            Square71x71Logo="Assets\Square71x71Logo.png"
            Square310x310Logo="Assets\Square310x310Logo.png"
            Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- The notebook's own format.  The application already opens
             files named on the command line, which is how the shell
             hands one over. -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="m42">
            <uap:DisplayName>math42 notebook</uap:DisplayName>
            <uap:Logo>Assets\StoreLogo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.m42</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A packaged desktop application: GTK, and the user's own files. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
